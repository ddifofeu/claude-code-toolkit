{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f ~/.claude/hooks/bash-guards.py ]; then python3 ~/.claude/hooks/bash-guards.py; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
